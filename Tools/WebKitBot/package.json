{
  "name": "WebKitBot",
  "version": "1.0.0",
  "description": "WebKitBot + WKR implementation",
  "type": "module",
  "main": "src/index.mjs",
  "dependencies": {
    "@slack/rtm-api": "^6.2.1",
    "@slack/web-api": "^6.9.1",
    "axios": "^1.12.0",
    "dotenv": "^8.2.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "node-persist": "^3.1.0",
    "replaceall": "^0.1.6",
    "rss-parser": "^3.13.0",
    "@snyk/protect": "latest"
  },
  "devDependencies": {},
  "scripts": {
    "test": "$NODE --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "$NODE ./src/index.mjs",
    "lint": "eslint src/*.mjs tests/*.mjs",
    "prepare": "npm run snyk-protect",
    "snyk-protect": "snyk-protect"
  },
  "jest": {
    "testMatch": [
      "**/?(*.)(spec|test).mjs"
    ],
    "transform": {},
    "testEnvironment": "jest-environment-node",
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "author": "webkit.org",
  "license": "BSD-2-Clause",
  "snyk": true
}
